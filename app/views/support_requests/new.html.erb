
<div class="support-container">
  <h1>支援要請登録</h1>

  <p class="support-description">
    必要としている物資や支援内容を入力してください。
  </p>

  <% if @support_request.errors.any? %>
    <div class="error-messages">
      <h3>入力内容を確認してください。</h3>
      <% @support_request.errors.full_messages.each do |message| %>
        <p><%= message %></p>
      <% end %>
    </div>
  <% end %>

  <%= form_with model: @support_request do |f| %>
    <div class="form-group">
      <%= f.label :title, "要請タイトル" %>
      <%= f.text_field :title,
          placeholder: "例：飲料水が必要です",
          required: true %>
    </div>

    <div class="form-group">
      <%= f.label :category, "支援カテゴリ" %>
      <%= f.select :category,
          SupportRequest::CATEGORIES.map { |c| [c, c] },
          { prompt: "カテゴリを選択してください" },
          required: true %>
    </div>

    <div class="form-group">
      <%= f.label :description, "必要な支援内容" %>
      <%= f.text_area :description,
          placeholder: "必要な物資の種類や数量などを入力してください",
          rows: 5,
          required: true %>
    </div>

    <div class="form-group">
      <%= f.label :address, "支援が必要な場所" %>
      <%= f.text_field :address,
          placeholder: "例：福岡県〇〇市〇〇町1-2-3",
          required: true %>
    </div>

    <div class="form-actions">
      <%= f.submit "支援要請を登録する", class: "submit-button" %>
      <%= link_to "トップページに戻る",
          top_index_path,
          class: "back-link" %>
    </div>
  <% end %>
</div>
